# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://kisanpath:kisanpath@postgres:5432/kisanpath
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=local-kisanpath-only

# HTTP runtime hardening
KISANPATH_JSON_LOGS=true
KISANPATH_CORS_ORIGINS=["http://localhost:3000"]
KISANPATH_PUBLIC_RATE_LIMIT=60
KISANPATH_ADMIN_RATE_LIMIT=20
KISANPATH_MAX_JSON_BYTES=1000000
KISANPATH_MAX_AUDIO_BYTES=15000000
KISANPATH_DEPENDENCY_TIMEOUT_SECONDS=2
KISANPATH_SHUTDOWN_GRACE_SECONDS=15

# JSON array supplied by a runtime secret manager/environment. Never commit tokens.
# Example shape: [{"token":"long-random-value","subject":"operator-id","roles":["operator"]}]
KISANPATH_ADMIN_TOKENS_JSON=

# Default LLM selection
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=
LLM_FALLBACK_ENABLED=true
LLM_EVALUATION_FALLBACK_ENABLED=false
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_INITIAL_BACKOFF_SECONDS=0.2
LLM_RETRY_MAX_BACKOFF_SECONDS=2
KISANPATH_LLM_CONFIG=backend/examples/llm.example.toml

# Provider credentials - fill locally, never commit real values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama / compatible endpoints
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Voice provider selection
STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
KISANPATH_VOICE_CONFIG=backend/examples/voice.example.toml
KISANPATH_RUN_LIVE_VOICE_TESTS=0

# Feature flags
VOICE_ENABLED=true

# Frontend API adapter. Leave empty to use reviewed synthetic demo data.
NEXT_PUBLIC_KISANPATH_API_URL=
