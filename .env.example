# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://kisanpath:kisanpath@postgres:5432/kisanpath
REDIS_URL=redis://redis:6379/0

# Default LLM selection
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=

# Provider credentials - fill locally, never commit real values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama / compatible endpoints
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Voice provider selection
STT_PROVIDER=
TTS_PROVIDER=

# Feature flags
LLM_FALLBACK_ENABLED=false
VOICE_ENABLED=true
