# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://kisanpath:kisanpath@postgres:5432/kisanpath
REDIS_URL=redis://redis:6379/0

# Default LLM selection
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=
LLM_FALLBACK_ENABLED=true
LLM_EVALUATION_FALLBACK_ENABLED=false
KISANPATH_LLM_CONFIG=backend/examples/llm.example.toml

# Provider credentials - fill locally, never commit real values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama / compatible endpoints
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Voice provider selection
STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
KISANPATH_VOICE_CONFIG=backend/examples/voice.example.toml
KISANPATH_RUN_LIVE_VOICE_TESTS=0

# Feature flags
VOICE_ENABLED=true
